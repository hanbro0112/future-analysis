rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 已登入使用者
    function isAuthenticated() {
      return request.auth != null;
    }

    // 路徑上的日期 (YYYYMMDD) 是否落在最近 5 天內（含當天），避免跨週末查詢上個交易日資料時被擋
    function isRecentDate(dateStr) {
      let docDate = timestamp.date(int(dateStr[0:4]), int(dateStr[4:6]), int(dateStr[6:8]));
      let today = timestamp.date(request.time.year(), request.time.month(), request.time.day());
      return docDate >= today - duration.value(5, 'd') && docDate <= today;
    }

    // 台指期分鐘資料：market/{symbol}/{date}/{docId}
    match /market/{symbol}/{date}/{docId} {
      allow read: if isAuthenticated() && isRecentDate(date);
    }

    // 每日分析報告：daily_reports/{date}
    match /daily_reports/{date} {
      allow read: if isAuthenticated() && isRecentDate(date);
    }

    // PTT Stock 板盤中/盤後閒聊：pttThreads/pttPosts/{date}_{session}
    match /pttThreads/{docId} {
      allow read: if isAuthenticated();
    }
    match /pttPosts/{docId} {
      allow read: if isAuthenticated();
    }

    // 使用者 PTT 閒聊個人設定（已讀位置、視窗大小）：users/{uid}/setting/pttReadState，僅本人可讀寫
    match /users/{uid}/setting/pttReadState {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }
  }
}
